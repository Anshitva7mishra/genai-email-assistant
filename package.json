{
  "name": "genai-email-assistant",
  "version": "1.0.0",
  "description": "GenAI Email Assistant — MERN microservices monorepo",
  "private": true,
  "scripts": {
    "up": "docker compose up --build",
    "down": "docker compose down",
    "down:clean": "docker compose down -v",
    "logs": "docker compose logs -f",
    "health": "node scripts/health-check.js"
  },
  "workspaces": [
    "shared",
    "gateway",
    "ai-service",
    "email-service",
    "template-service",
    "scheduler-service",
    "analytics-service"
  ]
}
